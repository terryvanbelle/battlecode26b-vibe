+// Replica only: the project's milestones (progress/milestones.csv, installed as /milestones.json by
+// `galaxy-setup.sh milestones`), drawn on every rating chart beside the tournament lines. A missing or malformed
+// file (the SPA fallback answers with index.html) draws nothing.
+interface Milestone {
+  tag: string;
+  label: string;
+  t: number;
+}
+let milestonesOnce: Promise<Milestone[]> | undefined;
+const loadMilestones = async (): Promise<Milestone[]> => {
+  milestonesOnce ??= fetch("/milestones.json", { cache: "no-cache" })
+    .then(async (r) => (r.ok ? ((await r.json()) as unknown) : []))
+    .then((m) =>
+      Array.isArray(m)
+        ? (m as Milestone[]).filter(
+            (x) =>
+              typeof x?.t === "number" &&
+              typeof x?.tag === "string" &&
+              typeof x?.label === "string",
+          )
+        : [],
+    )
+    .catch(() => []);
+  return await milestonesOnce;
+};
+
